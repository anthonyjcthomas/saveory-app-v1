# Saveory — environment variable template
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored. NEVER commit real keys.
#
# All EXPO_PUBLIC_ vars are embedded in the client bundle at build time.
#
# EAS / TestFlight / App Store: `eas build` does NOT read this file. Copy the same
# EXPO_PUBLIC_* names and values into expo.dev → Project → Environment variables
# for the Production (or Preview) environment, then rebuild. See docs/eas-environment-setup.md.

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Map (web + native directions): Maps JavaScript API, Geocoding, Directions — same key if enabled
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
