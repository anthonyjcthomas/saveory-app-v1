{
  "expo": {
    "name": "Saveory",
    "slug": "saveory",
    "jsEngine": "hermes",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./SaveoryLogo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./splash-screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anthonyjcthomas.Saveory",
      "icon": "./SaveoryLogo.png",
      "buildNumber": "12",
      "infoPlist": {
        "UIBackgroundModes": ["location", "remote-notification"],
        "NSLocationWhenInUseUsageDescription": "We need access to your location to show nearby deals and businesses.",
        "NSLocationAlwaysUsageDescription": "We need access to your location in the background to keep updating the deals near you.",
        "NSUserTrackingUsageDescription": "We use your data to provide personalized deals and promotions relevant to you."
      }
    },
    "android": {
      "package": "com.anthonyjcthomas.saveory",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "expo-tracking-transparency",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Saveory to use your location to show nearby deals and the map.",
          "locationWhenInUsePermission": "Allow Saveory to use your location to show nearby deals and the map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "84e2d133-27ae-4b09-b971-0dafc5a6f67a"
      }
    }
  }
}
